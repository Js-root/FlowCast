# GROQ_API_KEY: Required for Groq AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GROQ_API_KEY="MY_GROQ_API_KEY"

# TOMTOM_API_KEY: Free key from https://developer.tomtom.com for real Delhi
# traffic flow (segment speeds/congestion on map nodes). Without it, nodes use seed data.
TOMTOM_API_KEY="MY_TOMTOM_API_KEY"

# Reddit r/delhi is polled for real social incidents — no key required.
